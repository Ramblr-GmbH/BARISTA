{
  "dataset_root": "/data/barista",
  "output_dir": "runs/vlm",
  "model": {
    "provider": "openai_compat",
    "model": "qwen3.5-27b",
    "base_url": "http://localhost:8000/v1",
    "api_key_env": null,
    "temperature": 0.7,
    "max_output_tokens": 4096
  },
  "task": "relation_extraction",
  "concurrency": 1,
  "task_params": {
    "mask_alpha": 0.5,
    "alpha_segmentation_boundary": 0.9,
    "font_size": 20
  }
}
