{
  "dataset_root": "/data/barista",
  "output_dir": "runs/vlm",
  "model": {
    "provider": "azure_openai",
    "model": "gpt-5.4-mini",
    "base_url": "https://YOUR_AZURE_ENDPOINT.openai.azure.com/",
    "api_key_env": "OPENAI_API_KEY",
    "api_version": "2024-12-01-preview",
    "temperature": 0.7,
    "max_output_tokens": 4096,
    "thinking_level": "low"
  },
  "task": "relation_extraction",
  "concurrency": 8,
  "task_params": {
    "mask_alpha": 0.5,
    "alpha_segmentation_boundary": 0.9,
    "font_size": 20
  }
}
